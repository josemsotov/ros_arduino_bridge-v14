Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Kinect Point Cloud
      Enabled: true
      Topic:
        Value: /camera/depth/points
      Style: Points
      Size (m): 0.02
      Decay Time: 0
    - Class: rviz_default_plugins/Image
      Name: Kinect RGB
      Enabled: true
      Topic:
        Value: /camera/rgb/image_raw
  Enabled: true
  Global Options:
    Fixed Frame: camera_depth_optical_frame
    Frame Rate: 10
  Name: root
Window Geometry:
  Width: 1200
  Height: 800
