<?xml version="1.0"?>
<robot name="trolley_mode_b" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Mode B measurements, converted from centimetres to SI units. -->
  <xacro:property name="wheel_r" value="0.14"/>
  <xacro:property name="wheel_w" value="0.05"/>
  <xacro:property name="wheel_sep" value="0.40"/>
  <xacro:property name="caster_r" value="0.06"/>
  <xacro:property name="caster_w" value="0.02"/>
  <xacro:property name="caster_sep" value="0.12"/>
  <xacro:property name="caster_wheelbase" value="0.80"/>
  <xacro:property name="caster_offset" value="0.04"/>

  <!-- base_link origin: centre of driven axle, at axle height (0.14 m). -->
  <link name="base_link">
    <visual>
      <!-- Bottom of the 0.60 m body sits at driven-axle height, not on ground. -->
      <origin xyz="0 0 0.30"/>
      <geometry><box size="0.60 0.40 0.60"/></geometry>
      <material name="blue"><color rgba="0.15 0.35 0.75 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.30"/>
      <geometry><box size="0.60 0.40 0.60"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.10 0 0"/>
      <mass value="12.0"/>
      <inertia ixx="0.52" ixy="0" ixz="0" iyy="0.72" iyz="0" izz="0.52"/>
    </inertial>
  </link>

  <xacro:macro name="drive_wheel" params="side y">
    <link name="wheel_${side}">
      <visual><geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
        <material name="black"><color rgba="0.05 0.05 0.05 1"/></material></visual>
      <collision><geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry></collision>
      <inertial><mass value="0.7"/><inertia ixx="0.007" ixy="0" ixz="0" iyy="0.007" iyz="0" izz="0.014"/></inertial>
    </link>
    <joint name="joint_wheel_${side}" type="continuous">
      <parent link="base_link"/><child link="wheel_${side}"/>
      <origin xyz="0 ${y} 0" rpy="${pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.02" friction="0.01"/>
    </joint>
  </xacro:macro>
  <xacro:drive_wheel side="left" y="${wheel_sep/2}"/>
  <xacro:drive_wheel side="right" y="${-wheel_sep/2}"/>

  <!-- Two independently swivelling caster wheels. -->
  <xacro:macro name="caster" params="side y">
    <link name="caster_swivel_${side}">
      <inertial><mass value="0.05"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
    </link>
    <joint name="caster_swivel_joint_${side}" type="continuous">
      <parent link="base_link"/><child link="caster_swivel_${side}"/>
      <origin xyz="${caster_wheelbase} ${y} 0"/>
      <axis xyz="0 0 1"/><dynamics damping="0.04" friction="0.01"/>
    </joint>
    <link name="caster_wheel_${side}">
      <visual><geometry><cylinder radius="${caster_r}" length="${caster_w}"/></geometry>
        <material name="gray"><color rgba="0.35 0.35 0.35 1"/></material></visual>
      <collision><geometry><cylinder radius="${caster_r}" length="${caster_w}"/></geometry></collision>
      <inertial><mass value="0.10"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.00035"/></inertial>
    </link>
    <joint name="caster_wheel_joint_${side}" type="continuous">
      <parent link="caster_swivel_${side}"/><child link="caster_wheel_${side}"/>
      <origin xyz="${caster_offset} 0 ${caster_r-wheel_r}" rpy="${pi/2} 0 0"/>
      <axis xyz="0 0 1"/><dynamics damping="0.01" friction="0.005"/>
    </joint>
  </xacro:macro>
  <xacro:caster side="left" y="${caster_sep/2}"/>
  <xacro:caster side="right" y="${-caster_sep/2}"/>

  <link name="base_laser">
    <visual><geometry><cylinder radius="0.04" length="0.06"/></geometry>
      <material name="red"><color rgba="0.8 0.1 0.1 1"/></material></visual>
    <inertial><mass value="0.10"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="base_laser"/>
    <origin xyz="-0.10 0 ${0.78-wheel_r}" rpy="0 0 0"/>
  </joint>

  <link name="kinect_link">
    <visual><geometry><box size="0.28 0.07 0.07"/></geometry>
      <material name="kinect"><color rgba="0.08 0.08 0.08 1"/></material></visual>
    <inertial><mass value="0.29"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/></inertial>
  </link>
  <joint name="kinect_joint" type="fixed">
    <parent link="base_link"/><child link="kinect_link"/>
    <origin xyz="-0.10 0 ${0.72-wheel_r}" rpy="0 0 0"/>
  </joint>

  <link name="imu_link"><inertial><mass value="0.01"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial></link>
  <joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="0.10 0 0"/></joint>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>joint_wheel_left</left_joint><right_joint>joint_wheel_right</right_joint>
      <wheel_separation>${wheel_sep}</wheel_separation><wheel_radius>${wheel_r}</wheel_radius>
      <max_linear_velocity>0.40</max_linear_velocity><max_angular_velocity>0.70</max_angular_velocity>
      <!-- Provisional until loaded-ground acceleration is measured. -->
      <max_linear_acceleration>0.50</max_linear_acceleration>
      <min_linear_acceleration>-0.50</min_linear_acceleration>
      <max_angular_acceleration>1.00</max_angular_acceleration>
      <min_angular_acceleration>-1.00</min_angular_acceleration>
      <topic>cmd_vel</topic><odom_topic>odom</odom_topic><frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>joint_wheel_left</joint_name>
      <joint_name>joint_wheel_right</joint_name>
      <joint_name>caster_swivel_joint_left</joint_name>
      <joint_name>caster_swivel_joint_right</joint_name>
    </plugin>
  </gazebo>
  <gazebo reference="base_laser">
    <sensor name="lidar" type="gpu_lidar"><always_on>true</always_on><update_rate>10</update_rate><topic>scan</topic>
      <lidar><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
        <range><min>0.10</min><max>8.0</max><resolution>0.01</resolution></range></lidar>
    </sensor>
  </gazebo>
  <gazebo reference="imu_link">
    <sensor name="mpu9250" type="imu"><always_on>true</always_on><update_rate>200</update_rate><topic>imu/data_raw</topic>
      <imu><angular_velocity>
        <x><noise type="gaussian"><mean>0</mean><stddev>0.004</stddev></noise></x>
        <y><noise type="gaussian"><mean>0</mean><stddev>0.004</stddev></noise></y>
        <z><noise type="gaussian"><mean>-0.00024</mean><stddev>0.004</stddev></noise></z>
      </angular_velocity></imu>
    </sensor>
  </gazebo>
</robot>
