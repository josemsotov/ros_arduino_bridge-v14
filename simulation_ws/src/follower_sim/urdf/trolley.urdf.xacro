<?xml version="1.0"?>
<robot name="trolley" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="enable_kinect" default="false"/>

  <!-- Perfil real A_deployed; ver config/real_hardware_profile.yaml. -->
  <xacro:property name="base_w"  value="0.40"/>
  <xacro:property name="base_d"  value="0.60"/>
  <xacro:property name="base_h"  value="0.60"/>
  <xacro:property name="wheel_r" value="0.14"/>
  <xacro:property name="wheel_w" value="0.05"/>
  <xacro:property name="wb"      value="0.45"/>  <!-- half wheel separation -->

  <!-- Inertialess root required by KDL / robot_state_publisher. -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0"/>
  </joint>

  <!-- Base -->
  <link name="base_link">
    <visual>
      <geometry><box size="${base_d} ${base_w} ${base_h}"/></geometry>
      <material name="blue"><color rgba="0.2 0.4 0.8 1"/></material>
    </visual>
    <collision><geometry><box size="${base_d} ${base_w} ${base_h}"/></geometry></collision>
    <inertial><mass value="14"/><inertia ixx="0.607" ixy="0" ixz="0" iyy="0.840" iyz="0" izz="0.607"/></inertial>
  </link>

  <!-- Left wheel -->
  <link name="wheel_left">
    <visual><geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material></visual>
    <collision><geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry></collision>
    <inertial><mass value="0.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <joint name="joint_wheel_left" type="continuous">
    <parent link="base_link"/><child link="wheel_left"/>
    <origin xyz="0 ${wb} ${-base_h/2}" rpy="${pi/2} 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <!-- Right wheel -->
  <link name="wheel_right">
    <visual><geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material></visual>
    <collision><geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry></collision>
    <inertial><mass value="0.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <joint name="joint_wheel_right" type="continuous">
    <parent link="base_link"/><child link="wheel_right"/>
    <origin xyz="0 ${-wb} ${-base_h/2}" rpy="${pi/2} 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <!-- Dos casters reales de 0.12 m, separados 0.90 m longitudinalmente. -->
  <xacro:macro name="caster" params="name x">
    <link name="${name}">
      <visual><geometry><sphere radius="0.06"/></geometry>
        <material name="gray"><color rgba="0.5 0.5 0.5 1"/></material></visual>
      <collision><geometry><sphere radius="0.06"/></geometry></collision>
      <inertial><mass value="0.2"/><inertia ixx="0.00048" ixy="0" ixz="0" iyy="0.00048" iyz="0" izz="0.00048"/></inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/><child link="${name}"/>
      <!-- Mismo plano de contacto que las ruedas motrices (z=0.01 antes
           del asentamiento de la suspension numerica). -->
      <origin xyz="${x} 0 -0.38"/>
    </joint>
  </xacro:macro>
  <xacro:caster name="caster_front" x="0.45"/>
  <xacro:caster name="caster_rear" x="-0.45"/>

  <!-- Las ruedas caster reales pivotan libremente. Las esferas equivalentes
       necesitan friccion baja para no bloquear el giro diferencial. -->
  <gazebo reference="caster_front">
    <mu1>0.001</mu1><mu2>0.001</mu2>
  </gazebo>
  <gazebo reference="caster_rear">
    <mu1>0.001</mu1><mu2>0.001</mu2>
  </gazebo>

  <!-- LIDAR -->
  <link name="base_laser">
    <visual><geometry><cylinder radius="0.04" length="0.06"/></geometry>
      <material name="red"><color rgba="0.8 0.1 0.1 1"/></material></visual>
    <inertial><mass value="0.1"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="base_laser"/>
    <origin xyz="-0.10 0 1.35"/>
  </joint>

  <!-- MPU9250/6500: configuración equivalente al firmware real (200 Hz). -->
  <link name="imu_link">
    <inertial><mass value="0.01"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="0 0 0"/>
  </joint>

  <!-- Kinect / RGB-D opcional. La geometria y los frames permanecen en el
       URDF aunque el sensor solo se instancia cuando enable_kinect=true. -->
  <xacro:if value="$(arg enable_kinect)">
    <link name="kinect_link">
      <visual>
        <geometry><box size="0.07 0.28 0.07"/></geometry>
        <material name="kinect_gray"><color rgba="0.12 0.12 0.12 1"/></material>
      </visual>
      <inertial><mass value="0.35"/><inertia ixx="0.0024" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0024"/></inertial>
    </link>
    <joint name="kinect_joint" type="fixed">
      <parent link="base_link"/><child link="kinect_link"/>
      <origin xyz="-0.10 0 1.30"/>
    </joint>
    <link name="camera_depth_optical_frame"/>
    <joint name="camera_depth_optical_joint" type="fixed">
      <parent link="kinect_link"/><child link="camera_depth_optical_frame"/>
      <origin xyz="0 0 0" rpy="-${pi/2} 0 -${pi/2}"/>
    </joint>
    <link name="camera_rgb_optical_frame"/>
    <joint name="camera_rgb_optical_joint" type="fixed">
      <parent link="camera_depth_optical_frame"/><child link="camera_rgb_optical_frame"/>
      <origin xyz="0 0 0"/>
    </joint>
  </xacro:if>

  <!-- Gazebo plugins -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>joint_wheel_left</left_joint>
      <right_joint>joint_wheel_right</right_joint>
      <wheel_separation>${wb*2}</wheel_separation>
      <wheel_radius>${wheel_r}</wheel_radius>
      <!-- Límite real usado por Stadia/firmware: 0.40 m/s. -->
      <max_linear_velocity>0.40</max_linear_velocity>
      <max_angular_velocity>0.70</max_angular_velocity>
      <max_linear_acceleration>0.50</max_linear_acceleration>
      <max_angular_acceleration>1.00</max_angular_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
  </gazebo>

  <!-- LIDAR sensor -->
  <gazebo reference="base_laser">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <gz_frame_id>base_laser</gz_frame_id>
      <lidar>
        <scan><horizontal>
          <samples>360</samples><resolution>1</resolution>
          <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle>
        </horizontal></scan>
        <range><min>0.10</min><max>8.0</max><resolution>0.01</resolution></range>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="mpu9250" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <topic>imu/data_raw</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.004</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.004</stddev></noise></y>
          <z><noise type="gaussian"><mean>-0.00024</mean><stddev>0.004</stddev></noise></z>
        </angular_velocity>
      </imu>
    </sensor>
  </gazebo>

  <xacro:if value="$(arg enable_kinect)">
    <gazebo reference="kinect_link">
      <sensor name="kinect_rgbd" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>5</update_rate>
        <topic>kinect_sim</topic>
        <gz_frame_id>camera_depth_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.014</horizontal_fov>
          <image>
            <width>320</width><height>240</height><format>R8G8B8</format>
          </image>
          <clip><near>0.40</near><far>5.0</far></clip>
          <optical_frame_id>camera_depth_optical_frame</optical_frame_id>
        </camera>
        <visualize>false</visualize>
      </sensor>
    </gazebo>
  </xacro:if>

</robot>
